<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <ApplicationManifest>worker.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ThinkBookToolkit\ThinkBookToolkit.csproj" />
  </ItemGroup>
  <Target Name="CopyWorkerToDesktopOutput" AfterTargets="Build">
    <ItemGroup>
      <WorkerFiles Include="$(TargetDir)ThinkBookToolkit.GpuWorker.exe;$(TargetPath);$(TargetDir)ThinkBookToolkit.GpuWorker.deps.json;$(TargetDir)ThinkBookToolkit.GpuWorker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(MSBuildProjectDirectory)\..\ThinkBookToolkit\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)" SkipUnchangedFiles="true" />
  </Target>
</Project>
