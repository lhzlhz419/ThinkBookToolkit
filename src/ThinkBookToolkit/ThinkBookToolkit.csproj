<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ThinkBookToolkit</AssemblyName>
    <RootNamespace>ThinkBookToolkit</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon-tb.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ExternalDependenciesRoot Condition="'$(ExternalDependenciesRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\ThinkBookToolkit.Dependencies</ExternalDependenciesRoot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThinkBookToolkit.UiSmokeTests" />
    <InternalsVisibleTo Include="ThinkBookToolkit.UiPreview" />

    <ProjectReference Include="..\ThinkBookToolkit.FanBackend.Contracts\ThinkBookToolkit.FanBackend.Contracts.csproj" />
    <ProjectReference Include="..\ThinkBookToolkit.FanBackend.Wmi\ThinkBookToolkit.FanBackend.Wmi.csproj" />
    <ProjectReference Include="..\..\external\NvAPIWrapper\NvAPIWrapper\NvAPIWrapper.csproj"
                      AdditionalProperties="Configuration=$(Configuration);Platform=AnyCPU;NoWarn=1591;NuGetAudit=false" />
    <Compile Include="..\ThinkBookToolkit.Guardian\Program.cs" Link="Guardian\GuardianEntryPoint.cs" />
    <Compile Include="..\ThinkBookToolkit.Guardian\FanWatchdogMarker.cs" Link="Guardian\FanWatchdogMarker.cs" />
    <Compile Include="..\ThinkBookToolkit.Guardian\GuardianLog.cs" Link="Guardian\GuardianLog.cs" />
    <Compile Include="..\ThinkBookToolkit.Guardian\FanWatchdogService.cs" Link="Guardian\FanWatchdogService.cs" />
    <Compile Include="..\ThinkBookToolkit.Guardian\GpuMonitorWorker.cs" Link="Guardian\GpuMonitorWorker.cs" />

    <Content Include="default_app_settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="default_fan_curve_profiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="$(MSBuildProjectDirectory)\..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="$(MSBuildProjectDirectory)\..\..\THIRD_PARTY_NOTICES.md">
      <Link>THIRD_PARTY_NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Resource Include="Assets\app-icon-tb.png" />
    <Content Include="$(ExternalDependenciesRoot)\LenovoPcManager\WrapPlugin.dll"
             Condition="Exists('$(ExternalDependenciesRoot)\LenovoPcManager\WrapPlugin.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>LenovoPcManager\WrapPlugin.dll</TargetPath>
    </Content>

    <Content Include="$(ExternalDependenciesRoot)\VantageAddins\**\*"
             Condition="Exists('$(ExternalDependenciesRoot)\VantageAddins')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>VantageAddins\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="$(ExternalDependenciesRoot)\IntelPower\IntelMSR.bin"
             Condition="Exists('$(ExternalDependenciesRoot)\IntelPower\IntelMSR.bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>IntelMSR.bin</TargetPath>
    </Content>
    <Content Include="$(ExternalDependenciesRoot)\IntelPower\IntelMCHBAR.bin"
             Condition="Exists('$(ExternalDependenciesRoot)\IntelPower\IntelMCHBAR.bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>IntelMCHBAR.bin</TargetPath>
    </Content>
    <Content Include="$(ExternalDependenciesRoot)\IntelPower\InpOutx64.dll"
             Condition="Exists('$(ExternalDependenciesRoot)\IntelPower\InpOutx64.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>InpOutx64.dll</TargetPath>
    </Content>

    <PackageReference Include="DiskInfoToolkit" Version="2.1.2" />
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre717" />
    <PackageReference Include="LLT.WindowsDisplayAPI" Version="1.3.2-pre17" />
    <PackageReference Include="LLT.PresentMonFps" Version="2.0.8-pre.12" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
    <PackageReference Include="RAMSPDToolkit-NDD" Version="1.6.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.7" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.10" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />

  </ItemGroup>
</Project>
