    <AssemblyName>ThinkBookToolkit.UiPreview</AssemblyName>
    <RootNamespace>ThinkBookToolkit.UiPreview</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
