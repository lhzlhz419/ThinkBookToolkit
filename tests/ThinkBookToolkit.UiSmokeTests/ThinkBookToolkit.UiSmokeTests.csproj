<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ThinkBookToolkit.UiSmokeTests</AssemblyName>
    <RootNamespace>ThinkBookToolkit.UiSmokeTests</RootNamespace>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThinkBookToolkit\ThinkBookToolkit.csproj" />
    <ProjectReference Include="..\..\plugins\ThinkBookToolkit.PluginTest\ThinkBookToolkit.PluginTest.csproj" />
    <ProjectReference Include="..\ThinkBookToolkit.FakeFanBackend\ThinkBookToolkit.FakeFanBackend.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyFanBackendFixture" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ThinkBookToolkit.FakeFanBackend\bin\$(Configuration)\net9.0-windows\ThinkBookToolkit.FanBackend.dll" DestinationFolder="$(TargetDir)fixtures" />
  </Target>
</Project>
